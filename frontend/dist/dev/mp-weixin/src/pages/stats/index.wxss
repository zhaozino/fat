
.page.data-v-774cec60 {
  padding: 16px;
  padding-bottom: 80px;
  background: #f5f7f5;
  min-height: 100vh;
}

/* 头部 - sticky 固定在顶部 */
.header.data-v-774cec60 {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #f5f7f5;
  text-align: center;
  padding: 6px 0;
  margin: 0 -16px 16px;
}
.title.data-v-774cec60 {
  display: block;
  font-size: 16px; color: #2ecc71; font-weight: 600;
}

/* 卡片 */
.card.data-v-774cec60 {
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}
.card-title.data-v-774cec60 {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #eee;
}

/* 日期范围 */
.date-range-header.data-v-774cec60 {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12px;
}
.date-range-inputs.data-v-774cec60 {
  display: flex;
  align-items: flex-end;
  gap: 12px;
  margin-bottom: 12px;
}
.date-input-group.data-v-774cec60 { flex: 1;
}
.date-input-group .label.data-v-774cec60 {
  display: block;
  font-size: 12px;
  color: #7f8c8d;
  margin-bottom: 4px;
}
.date-input.data-v-774cec60 {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 14px;
  box-sizing: border-box;
}
.date-separator.data-v-774cec60 {
  color: #7f8c8d;
  padding-bottom: 10px;
}
.quick-date-btns.data-v-774cec60 {
  display: flex;
  gap: 8px;
}
.quick-date-btn.data-v-774cec60 {
  flex: 1;
  padding: 8px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background: #fff;
  color: #7f8c8d;
  font-size: 13px;
  text-align: center;
}
.quick-date-btn.active.data-v-774cec60 {
  background: #2ecc71;
  border-color: #2ecc71;
  color: #fff;
}

/* 图表 */
.chart-container.data-v-774cec60 { min-height: 240px;
}
.chart.data-v-774cec60 { width: 100%; height: 200px;
}

/* 数据汇总 */
.summary-grid.data-v-774cec60 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
.summary-item.data-v-774cec60 {
  text-align: center;
  padding: 12px;
  background: #f8f9fa;
  border-radius: 8px;
}
.summary-item .label.data-v-774cec60 {
  display: block;
  font-size: 12px;
  color: #7f8c8d;
  margin-bottom: 4px;
}
.value-row.data-v-774cec60 {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4px;
}
.summary-item .value.data-v-774cec60 {
  font-size: 24px;
  font-weight: 600;
  color: #2ecc71;
}
.summary-item .small.data-v-774cec60 {
  font-size: 11px;
  color: #95a5a6;
}

/* 历史记录 */
.history-item.data-v-774cec60 {
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}
.history-item.data-v-774cec60:last-child { border-bottom: none;
}
.history-date.data-v-774cec60 {
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 6px;
}
.achieved-tag.data-v-774cec60 { color: #2ecc71; font-size: 12px; font-weight: normal;
}
.history-detail.data-v-774cec60 {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: #7f8c8d;
}
.history-deficit.data-v-774cec60 { font-weight: 600; color: #2ecc71;
}
.empty.data-v-774cec60 {
  text-align: center;
  color: #7f8c8d;
  padding: 20px 0;
  font-size: 14px;
}
