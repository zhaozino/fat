.page {
  display: flex; flex-direction: column;
  min-height: 100vh; background: #f5f7f5;
  padding-bottom: 120px;
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #f5f7f5;
  text-align: center;
  padding: 6px 0;
}
.title {
  display: block;
  font-size: 16px; color: #2ecc71; font-weight: 600;
}

.chat-scroll { flex: 1; overflow: hidden; }
.chat-list {
  padding: 16px 16px 24px;
}

/* 消息行：占满整行宽度 */
.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16px;
  width: 100%;
}

/* AI 消息靠左 */
.msg-left {
  flex-direction: row;
  justify-content: flex-start;
}

/* 用户消息靠右 */
.msg-right {
  flex-direction: row-reverse;
  justify-content: flex-start;
}

/* 头像 */
.avatar {
  width: 40px; height: 40px;
  border-radius: 6px;
  color: #fff; font-size: 12px; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.ai-av {
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  margin-right: 10px;
}
.user-av {
  background: #3498db;
  margin-left: 10px;
}

/* 气泡 */
.bubble {
  max-width: 70%;
  padding: 10px 14px;
  font-size: 14px;
  line-height: 1.5;
  word-break: break-all;
  position: relative;
}
.ai-bubble {
  background: #fff;
  color: #2c3e50;
  border-radius: 0 12px 12px 12px;
}
.user-bubble {
  background: #2ecc71;
  color: #fff;
  border-radius: 12px 0 12px 12px;
}

.img-msg { display: flex; flex-direction: column; }
.msg-image { width: 160px; border-radius: 8px; margin-bottom: 6px; }

.hint { display: block; font-size: 12px; color: #7f8c8d; margin-top: 6px; }
.loading-dots { color: #95a5a6; }

.input-area {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  display: flex; align-items: center;
  padding: 8px 12px;
  padding-bottom: calc(8px + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1px solid #e5e5e5;
  box-sizing: border-box;
  z-index: 50;
}

.camera-btn {
  width: 36px; height: 36px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  margin-right: 8px;
}
.icon-img { width: 22px; height: 22px; }
.send-btn .icon-img { width: 20px; height: 20px; }

.input-wrapper {
  flex: 1; min-width: 0;
  display: flex; align-items: center;
  background: #fff; border-radius: 20px;
  padding: 4px 8px;
  min-height: 36px;
}
.chat-input {
  flex: 1; width: 100%;
  padding: 6px 8px;
  border: none; background: transparent;
  font-size: 14px;
  line-height: 1.4;
}

.send-btn {
  width: 36px; height: 36px; flex-shrink: 0;
  background: #2ecc71; color: #fff;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-left: 8px;
}

/* 语音按钮 */
.voice-btn {
  width: 36px; height: 36px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  margin-right: 8px;
}
.voice-btn.active {
  background: #e8f5e9;
}
.voice-icon {
  font-size: 20px;
}

/* 录音浮层 */
.voice-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.voice-modal {
  width: 240rpx; height: 240rpx;
  background: rgba(0,0,0,0.75);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.voice-waves {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 60rpx;
  margin-bottom: 16rpx;
}
.voice-wave {
  width: 8rpx;
  margin: 0 6rpx;
  background: #2ecc71;
  border-radius: 4rpx;
  animation: wave 0.6s ease-in-out infinite alternate;
}
.voice-wave:nth-child(1) { height: 24rpx; animation-delay: 0s; }
.voice-wave:nth-child(2) { height: 40rpx; animation-delay: 0.2s; }
.voice-wave:nth-child(3) { height: 24rpx; animation-delay: 0.4s; }

@keyframes wave {
  from { height: 16rpx; }
  to   { height: 48rpx; }
}

.voice-tip {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
.voice-sub {
  color: rgba(255,255,255,0.6);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.ph { color: #b2b2b2; }
