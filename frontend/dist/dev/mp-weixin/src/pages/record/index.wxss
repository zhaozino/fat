
.page.data-v-e218755a {
  display: flex; flex-direction: column;
  min-height: 100vh; background: #f5f7f5;
  padding-bottom: 120px;  /* 为 input-area(60) + tabbar(60) 留空间 */
}

/* 头部 - sticky 固定在顶部 */
.header.data-v-e218755a {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #f5f7f5;
  text-align: center;
  padding: 6px 0;
}
.title.data-v-e218755a {
  display: block;
  font-size: 16px; color: #2ecc71; font-weight: 600;
}
.chat-scroll.data-v-e218755a { flex: 1; overflow: hidden;
}
.chat-list.data-v-e218755a {
  padding: 16px 16px 24px;
  display: flex; flex-direction: column; gap: 12px;
}
.msg.data-v-e218755a { display: flex; align-items: flex-start; gap: 10px; max-width: 85%;
}
.msg.user.data-v-e218755a { flex-direction: row-reverse; align-self: flex-end;
}
.avatar.data-v-e218755a {
  width: 32px; height: 32px; border-radius: 50%;
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  color: #fff; font-size: 11px; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.user-av.data-v-e218755a { background: #3498db;
}
.bubble.data-v-e218755a {
  padding: 10px 14px;
  border-radius: 12px; font-size: 14px;
  line-height: 1.5; word-break: break-all;
  box-shadow: 0 1px 2px rgba(0,0,0,0.1);
}
.ai-bubble.data-v-e218755a   { background: #e8f5e9; color: #2c3e50;
}
.user-bubble.data-v-e218755a { background: #3498db; color: #fff;
}
.img-msg.data-v-e218755a { display: flex; flex-direction: column; gap: 6px;
}
.msg-image.data-v-e218755a { width: 160px; border-radius: 8px;
}
.hint.data-v-e218755a { display: block; font-size: 12px; color: #7f8c8d; margin-top: 6px;
}
.loading-dots.data-v-e218755a { color: #95a5a6;
}

/* 输入区 - 固定在 tabbar 上方 */
.input-area.data-v-e218755a {
  position: fixed;
  bottom: 60px;  /* tabbar 高度 */
  left: 0; right: 0;
  width: 100%; max-width: 414px;
  margin: 0 auto;
  display: flex; align-items: center; gap: 8px;
  padding: 8px 12px;
  background: #f7f7f7;
  border-top: 1px solid #e5e5e5;
  box-sizing: border-box;
  z-index: 50;
}
.camera-btn.data-v-e218755a {
  width: 36px; height: 36px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: #2ecc71;
}
.icon-img.data-v-e218755a { width: 22px; height: 22px;
}
.send-btn .icon-img.data-v-e218755a { width: 20px; height: 20px;
}
.input-wrapper.data-v-e218755a {
  flex: 1; min-width: 0;
  display: flex; align-items: center;
  background: #fff; border-radius: 20px;
  padding: 4px 8px;
  min-height: 36px;
}
.chat-input.data-v-e218755a {
  flex: 1; width: 100%;
  padding: 6px 8px;
  border: none; background: transparent;
  font-size: 14px; outline: none;
  line-height: 1.4;
}
.send-btn.data-v-e218755a {
  width: 36px; height: 36px; flex-shrink: 0;
  background: #2ecc71; color: #fff;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.ph.data-v-e218755a { color: #b2b2b2;
}
