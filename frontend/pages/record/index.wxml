<view class="page">
  <view class="header" style="padding-top:{{statusBarHeight}}px"><text class="title">记录</text></view>

  <!-- 消息列表 -->
  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation>
    <view class="chat-list">
      <!-- 欢迎消息 -->
      <view class="msg msg-left">
        <view class="avatar ai-av">AI</view>
        <view class="bubble ai-bubble">
          <text>你好！告诉我你吃了什么或者做了什么运动，我来帮你记录~</text>
          <text class="hint">支持三种输入方式：</text>
          <text class="hint">文字输入 | 拍照识别 | 语音输入</text>
        </view>
      </view>

      <block wx:for="{{messages}}" wx:key="id">
        <!-- AI 消息：头像左，气泡靠左 -->
        <view wx:if="{{item.role === 'ai'}}" class="msg msg-left" id="msg-{{item.id}}">
          <view class="avatar ai-av">AI</view>
          <view class="bubble ai-bubble">
            <text>{{item.text}}</text>
          </view>
        </view>
        <!-- 用户消息：头像右，气泡靠右 -->
        <view wx:else class="msg msg-right" id="msg-{{item.id}}">
          <view wx:if="{{item.imageUrl}}" class="bubble user-bubble img-msg">
            <image src="{{item.imageUrl}}" mode="widthFix" class="msg-image" />
            <text wx:if="{{item.text}}">{{item.text}}</text>
          </view>
          <view wx:else class="bubble user-bubble">
            <text>{{item.text}}</text>
          </view>
          <view class="avatar user-av">我</view>
        </view>
      </block>

      <!-- loading -->
      <view wx:if="{{loading}}" class="msg msg-left" id="msg-loading">
        <view class="avatar ai-av">AI</view>
        <view class="bubble ai-bubble">
          <text class="loading-dots">识别中...</text>
        </view>
      </view>

      <view id="chat-bottom"></view>
    </view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="input-area">
    <view class="camera-btn" bindtap="onCamera">
      <image class="icon-img" src="/static/icons/camera.png" mode="aspectFit" />
    </view>
    <view class="input-wrapper">
      <input
        class="chat-input"
        value="{{inputText}}"
        placeholder="输入食物或运动..."
        placeholder-class="ph"
        confirm-type="send"
        bindconfirm="onSend"
        bindinput="onInputChange"
        adjust-position="{{true}}"
      />
    </view>
    <view class="send-btn" bindtap="onSend">
      <image class="icon-img" src="/static/icons/send.png" mode="aspectFit" />
    </view>
  </view>
</view>
