<view class="login-page" style="padding-top:{{statusBarHeight}}px">
  <view class="logo-area">
    <view class="logo-icon">瘦</view>
    <text class="logo-title">轻卡笔记</text>
    <text class="logo-sub">科学管理热量，轻松达成目标</text>
  </view>

  <view class="form-card">
    <!-- 手机号输入 -->
    <view class="form-group">
      <text class="label">手机号</text>
      <view class="phone-row">
        <picker class="prefix-picker" range="{{areaCodes}}" range-key="label" value="{{areaIndex}}" bindchange="onAreaChange">
          <view class="prefix">{{areaCodes[areaIndex].code}} ▾</view>
        </picker>
        <input
          class="phone-input"
          type="number"
          value="{{phone}}"
          maxlength="{{areaCodes[areaIndex].maxLen}}"
          placeholder="请输入手机号"
          placeholder-class="ph"
          bindinput="onPhoneInput"
        />
      </view>
      <text wx:if="{{phoneTip}}" class="tip error">{{phoneTip}}</text>
    </view>

    <!-- 验证码输入 -->
    <view class="form-group" wx:if="{{codeSent}}">
      <text class="label">验证码</text>
      <view class="code-row">
        <input
          class="code-input"
          type="number"
          value="{{code}}"
          maxlength="6"
          placeholder="请输入6位验证码"
          placeholder-class="ph"
          bindinput="onCodeInput"
        />
        <button
          class="resend-btn"
          disabled="{{countdown > 0}}"
          bindtap="sendCode"
        >
          {{countdown > 0 ? countdown + 's后重发' : '重新获取'}}
        </button>
      </view>
      <text wx:if="{{tip}}" class="tip {{tipType}}">{{tip}}</text>
    </view>

    <!-- 主按钮 -->
    <button
      class="submit-btn"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >
      {{submitting ? '处理中…' : (codeSent ? '登录 / 注册' : '获取验证码')}}
    </button>

    <text class="agreement">登录即代表同意
      <text class="link">《用户协议》</text>和
      <text class="link">《隐私政策》</text>
    </text>
  </view>
</view>
