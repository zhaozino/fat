
.page.data-v-f97f9319 { padding: 0 16px 80px; background: #f5f7f5; min-height: 100vh;
}

/* 头部 - sticky 固定在顶部（对齐 light-fit.html） */
.header.data-v-f97f9319 {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #f5f7f5;
  text-align: center;
  padding: 6px 0;
  margin: 0 -16px 16px;
}
.title.data-v-f97f9319 {
  display: block;
  font-size: 16px; color: #2ecc71; font-weight: 600;
}
.card.data-v-f97f9319 {
  background: #fff; border-radius: 24rpx;
  padding: 28rpx; margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.card-title.data-v-f97f9319 {
  display: block; font-size: 28rpx; font-weight: 600; color: #333;
  margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0;
}
.user-card.data-v-f97f9319 { display: flex; align-items: center; gap: 24rpx;
}
.user-avatar.data-v-f97f9319 { font-size: 64rpx;
}
.user-phone.data-v-f97f9319 { display: block; font-size: 32rpx; font-weight: 600; color: #333;
}
.user-sub.data-v-f97f9319   { display: block; font-size: 22rpx; color: #95a5a6; margin-top: 4rpx;
}
.form-group.data-v-f97f9319  { margin-bottom: 28rpx;
}
.form-row.data-v-f97f9319    { display: flex; gap: 20rpx;
}
.half.data-v-f97f9319        { flex: 1;
}
.label.data-v-f97f9319       { display: block; font-size: 26rpx; color: #333; margin-bottom: 12rpx;
}
.input.data-v-f97f9319 {
  width: 100%; height: 88rpx;
  border: 1rpx solid #e0e0e0; border-radius: 12rpx;
  padding: 0 24rpx; font-size: 28rpx; background: #fafafa;
}
.gender-row.data-v-f97f9319  { display: flex; gap: 16rpx;
}
.gender-btn.data-v-f97f9319  {
  flex: 1; height: 80rpx; line-height: 80rpx; text-align: center;
  border: 1rpx solid #e0e0e0; border-radius: 12rpx;
  font-size: 28rpx; background: #fff; color: #666;
}
.gender-btn.active.data-v-f97f9319 { border-color: #2ecc71; background: #e8f5e9; color: #2ecc71;
}
.picker-row.data-v-f97f9319 {
  display: flex; justify-content: space-between; align-items: center;
  height: 88rpx; border: 1rpx solid #e0e0e0; border-radius: 12rpx;
  padding: 0 24rpx; font-size: 28rpx; background: #fafafa;
}
.arrow.data-v-f97f9319 { color: #ccc; font-size: 36rpx;
}
.hint.data-v-f97f9319  { display: block; font-size: 22rpx; color: #95a5a6; margin-top: 8rpx;
}
.save-btn.data-v-f97f9319 {
  width: 100%; height: 96rpx;
  background: #2ecc71; color: #fff;
  border-radius: 16rpx; font-size: 32rpx; font-weight: 600; border: none;
}
.save-btn[disabled].data-v-f97f9319 { opacity: 0.5;
}
.bmr-card.data-v-f97f9319 { text-align: center; padding: 32rpx;
}
.bmr-label.data-v-f97f9319 { display: block; font-size: 24rpx; color: #95a5a6; margin-bottom: 8rpx;
}
.bmr-val.data-v-f97f9319   { display: block; font-size: 64rpx; font-weight: 700; color: #2ecc71;
}
.bmr-unit.data-v-f97f9319  { display: block; font-size: 22rpx; color: #bdc3c7;
}
.actions-card.data-v-f97f9319 { display: flex; gap: 16rpx;
}
.action-btn.data-v-f97f9319 {
  flex: 1; height: 88rpx;
  border: 1rpx solid #e0e0e0; border-radius: 12rpx;
  background: #fff; font-size: 28rpx; color: #555;
}
.action-btn.danger.data-v-f97f9319 { border-color: #e74c3c; color: #e74c3c;
}
.action-btn.full.data-v-f97f9319   { width: 100%;
}
